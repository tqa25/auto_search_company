# Firecrawl API key — required for search and scrape modules
FIRECRAWL_API_KEY=fc-your-api-key-here

# Google Gemini API key — required for Quick Search (step 1) and AI extraction (step 3)
GEMINI_API_KEY=your-gemini-api-key-here

# Serper API key — required for Deep Search (step 2)
SERPER_API_KEY=your-serper-api-key-here

# --- Pipeline toggles ---
# Google Maps (Serper Places) — optional, default OFF
GOOGLE_MAPS_ENABLED=false

# AI Extractor model name
AI_EXTRACTOR_MODEL=gemini-2.0-flash

# --- Dashboard auth (optional — leave DASHBOARD_PASS empty to disable) ---
DASHBOARD_USER=admin
DASHBOARD_PASS=
